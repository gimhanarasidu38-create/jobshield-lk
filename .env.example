# Copy to .env and fill in ONE key. Never commit .env.
# Option A: Google Gemini (has a free tier) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Option B: Anthropic Claude -> https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# AI_PROVIDER=gemini        # or anthropic (auto-detected from whichever key is set)
# AI_MODEL=                 # defaults: gemini-2.5-flash / claude-haiku-5-5
PORT=3000
# Used to hash reporter IPs and reported identifiers. Set any random string.
HASH_SALT=change-me-to-a-random-string
